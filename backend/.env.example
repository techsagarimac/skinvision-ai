APP_NAME=SkinVision AI
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./data/skinvision.db

# Leave missing to use Demo AI Detection (MockDetector).
MODEL_PATH=../models/acne_yolo.pt
FACE_LANDMARKER_PATH=../models/face_landmarker.task
DOWNLOAD_FACE_MODEL=true
USE_MEDIAPIPE_TASKS=false
YOLO_CONFIDENCE=0.35
# auto | mock | yolo
DETECTOR_MODE=auto
MAX_IMAGE_SIZE=1280
MAX_UPLOAD_BYTES=8388608
LOG_LEVEL=INFO
