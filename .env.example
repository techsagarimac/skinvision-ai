# Shared local development defaults.
# Copy values into frontend/.env.local and backend/.env as needed.

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (FastAPI) ---
APP_NAME=SkinVision AI
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./data/skinvision.db

# Detection
# Leave MODEL_PATH empty or pointing to a missing file to use Demo AI Detection.
MODEL_PATH=../models/acne_yolo.pt
FACE_LANDMARKER_PATH=../models/face_landmarker.task
DOWNLOAD_FACE_MODEL=true
USE_MEDIAPIPE_TASKS=false
YOLO_CONFIDENCE=0.35
DETECTOR_MODE=auto
MAX_IMAGE_SIZE=1280
MAX_UPLOAD_BYTES=8388608

# Logging
LOG_LEVEL=INFO
